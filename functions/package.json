{
  "name": "fenix-ec-suite-functions",
  "description": "Cloud Functions de Fenix EC Suite (proyecto finalinmobiliaria) — publicación automática en Facebook al aprobar una propiedad.",
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions:fenixecsuite",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2"
  },
  "private": true
}
